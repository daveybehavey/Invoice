OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-nano
# Optional faster model for wording-only rewrites; falls back to OPENAI_MODEL when unset
OPENAI_WORDING_MODEL=gpt-4.1-mini
PORT=3000
# file | postgres | auto
INVOICE_STORE_BACKEND=auto
INVOICE_DEFAULT_USER_ID=local-default
INVOICE_STORE_POSTGRES_URL=
# DATABASE_URL=postgres://...
# Optional override (default is true in production, false otherwise)
# INVOICE_STORE_REQUIRE_POSTGRES=true
# Optional override (default is true in production when Postgres is required)
# INVOICE_STORE_REQUIRE_MIGRATION_COMPLETE=true
# Optional override (default is true in production, false otherwise)
# INVOICE_REQUIRE_AUTH=true
# Required in production when auth is enabled (must be a strong non-default secret)
INVOICE_SESSION_SECRET=change_me
INVOICE_SESSION_TTL_HOURS=720

# Optional OCR telemetry export
OCR_METRICS_EXPORT_PROVIDER=webhook
OCR_METRICS_EXPORT_URL=
OCR_METRICS_GA4_MEASUREMENT_ID=
OCR_METRICS_GA4_API_SECRET=
OCR_METRICS_GA4_ENDPOINT=
OCR_METRICS_SEGMENT_WRITE_KEY=
OCR_METRICS_SEGMENT_ENDPOINT=
OCR_METRICS_EXPORT_AUTOSEND=false

# Optional friction snapshot location for diagnostics
FLOW_FRICTION_REPORT_FILE=docs/flow-friction-latest.json
FLOW_FRICTION_HISTORY_FILE=data/flow-friction-history.json
