OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-nano
# Optional wording-only override. If unset, wording tasks fall back to OPENAI_MODEL.
# OPENAI_WORDING_MODEL=gpt-4.1-mini
# Optional second fallback when OPENAI_WORDING_MODEL is unset.
# OPENAI_WORDING_MODEL_FALLBACK=gpt-4.1-mini
PORT=3000
# file | postgres | auto
INVOICE_STORE_BACKEND=auto
INVOICE_DEFAULT_USER_ID=local-default
INVOICE_STORE_POSTGRES_URL=
# DATABASE_URL=postgres://...
# Optional runtime snapshot override for auxiliary stores (billing/delivery/OCR/friction).
# Defaults to follow INVOICE_STORE_BACKEND when Postgres is configured.
# INVOICE_RUNTIME_STORE_BACKEND=postgres
# Optional override (default is true in production, false otherwise)
# INVOICE_STORE_REQUIRE_POSTGRES=true
# Optional override (default is true in production when Postgres is required)
# INVOICE_STORE_REQUIRE_MIGRATION_COMPLETE=true
# Optional override (default is true in production, false otherwise)
# INVOICE_REQUIRE_AUTH=true
# Required in production when auth is enabled (must be a strong non-default secret).
# Verified email sign-in also requires a working email delivery provider below.
INVOICE_SESSION_SECRET=change_me
INVOICE_SESSION_TTL_HOURS=720
# Optional sign-in link lifetime in minutes (default 15)
# INVOICE_EMAIL_LINK_TTL_MINUTES=15
# free | pro
INVOICE_DEFAULT_PLAN=free
# Optional per-month cap for new saved invoices on free plan (unset = unlimited in dev/test, 25 in production)
INVOICE_FREE_SAVE_LIMIT_PER_MONTH=
# Optional allowlists for forcing Pro access before billing integration
INVOICE_PRO_EMAILS=
INVOICE_PRO_USER_IDS=
INVOICE_PRO_OWNER_IDS=
# Optional plan CTA links surfaced in launcher/library/manual upgrade prompts
INVOICE_UPGRADE_URL=
INVOICE_BILLING_PORTAL_URL=

# Optional Stripe billing (freemium upgrade automation)
# When configured, frontend can open Stripe Checkout/Portal sessions via API.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Optional defaults for `npm run setup:stripe-launch`
# STRIPE_LAUNCH_PRODUCT_NAME=NoteBill Pro
# STRIPE_LAUNCH_PRICE_AMOUNT_CENTS=1900
# STRIPE_LAUNCH_PRICE_CURRENCY=usd
# STRIPE_LAUNCH_PRICE_INTERVAL=month
# Optional launch gate. When true, launch diagnostics require live Stripe keys.
INVOICE_LAUNCH_REQUIRE_LIVE_BILLING=
# Optional override for Stripe entitlement snapshot storage.
STRIPE_ENTITLEMENTS_STORE_FILE=

# Optional Google Play Billing for Android in-app subscriptions/purchases.
# Required before Android upgrade buttons can verify purchases and unlock Pro.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=app.notebill.app
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=notebill_premium
GOOGLE_PLAY_SUBSCRIPTION_BASE_PLAN_ID=premium-monthly
GOOGLE_PLAY_SUBSCRIPTION_PLAN_IDS=premium-weekly,premium-monthly,premium-3months,premium-yearly
# Optional. Leave blank to buy the base plan directly without forcing a trial/offer path.
GOOGLE_PLAY_SUBSCRIPTION_OFFER_ID=
GOOGLE_PLAY_LIFETIME_PRODUCT_ID=notebill_premium_lifetime

# Optional absolute public app URL for checkout/portal return URLs.
# Example: https://app.notebill.app
APP_BASE_URL=
# Optional GA4 web measurement tag for NoteBill marketing/app pages.
GOOGLE_ANALYTICS_MEASUREMENT_ID=
# Optional local URL for `npm run check:launch` (defaults to http://localhost:3000)
# LAUNCH_CHECK_BASE_URL=http://localhost:3000

# Optional invoice email delivery provider (send-from-library)
# INVOICE_EMAIL_PROVIDER=none | resend | smtp2go
INVOICE_EMAIL_PROVIDER=
INVOICE_FROM_EMAIL=
RESEND_API_KEY=
SMTP2GO_API_KEY=
# Optional recipient used by `npm run send:launch-email-test`
INVOICE_LAUNCH_TEST_EMAIL=
# Optional reminder scheduler defaults (for /api/invoices/reminders/run)
# INVOICE_REMINDER_DUE_DAYS=14
# INVOICE_REMINDER_COOLDOWN_DAYS=7
# INVOICE_REMINDER_MAX_PER_RUN=25

# Optional Cloudflare API credentials (for public-domain/email-routing scripts)
CLOUDFLARE_EMAIL=
CLOUDFLARE_GLOBAL_API_KEY=

# Optional OCR telemetry export
OCR_METRICS_EXPORT_PROVIDER=webhook
OCR_METRICS_EXPORT_URL=
OCR_METRICS_GA4_MEASUREMENT_ID=
OCR_METRICS_GA4_API_SECRET=
OCR_METRICS_GA4_ENDPOINT=
OCR_METRICS_SEGMENT_WRITE_KEY=
OCR_METRICS_SEGMENT_ENDPOINT=
OCR_METRICS_EXPORT_AUTOSEND=false

# Optional friction snapshot location for diagnostics
FLOW_FRICTION_REPORT_FILE=docs/flow-friction-latest.json
FLOW_FRICTION_HISTORY_FILE=data/flow-friction-history.json

