{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "notebill-app",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-04-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "app.notebill.app/*",
      "zone_name": "notebill.app"
    },
    {
      "pattern": "notebill.app/*",
      "zone_name": "notebill.app"
    },
    {
      "pattern": "www.notebill.app/*",
      "zone_name": "notebill.app"
    }
  ],
  "vars": {
    "APP_BASE_URL": "https://app.notebill.app",
    "GOOGLE_ADS_CUSTOMER_ID": "978-945-6142",
    "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "526-580-0864",
    "GOOGLE_PLAY_LIFETIME_PRODUCT_ID": "notebill_premium_lifetime",
    "GOOGLE_PLAY_PACKAGE_NAME": "app.notebill.app",
    "GOOGLE_PLAY_SUBSCRIPTION_BASE_PLAN_ID": "premium-monthly",
    "GOOGLE_PLAY_SUBSCRIPTION_PLAN_IDS": "premium-weekly,premium-monthly,premium-3months,premium-yearly",
    "INVOICE_EMAIL_PROVIDER": "smtp2go",
    "INVOICE_FROM_EMAIL": "NoteBill <invoices@notebill.app>",
    "INVOICE_LAUNCH_TEST_EMAIL": "davidiheslop@gmail.com",
    "INVOICE_REQUIRE_AUTH": "false",
    "INVOICE_SESSION_TTL_HOURS": "720",
    "INVOICE_STORE_BACKEND": "auto",
    "INVOICE_STORE_REQUIRE_POSTGRES": "false",
    "OPENAI_MODEL": "gpt-5-nano",
    "OPENAI_WORDING_MODEL": "gpt-4.1-mini"
  },
  "secrets": {
    "required": [
      "GOOGLE_ADS_DEVELOPER_TOKEN",
      "GOOGLE_ADS_CLIENT_ID",
      "GOOGLE_ADS_CLIENT_SECRET",
      "GOOGLE_ADS_REFRESH_TOKEN",
      "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON",
      "OPENAI_API_KEY",
      "INVOICE_SESSION_SECRET",
      "INVOICE_STORE_POSTGRES_URL",
      "STRIPE_SECRET_KEY",
      "STRIPE_PUBLISHABLE_KEY",
      "STRIPE_PRICE_ID",
      "STRIPE_WEBHOOK_SECRET",
      "RESEND_API_KEY",
      "SMTP2GO_API_KEY"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/.well-known/*"
    ]
  }
}

