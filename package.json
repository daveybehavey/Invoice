{
  "name": "invoice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "node scripts/build-frontend.mjs",
    "postinstall": "patch-package",
    "predev": "npm run build:frontend",
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build:frontend",
    "start": "tsx src/server.ts",
    "prebuild": "npm run build:frontend",
    "build": "tsc --noEmit",
    "pretest": "npm run build:frontend",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts",
    "test:friction": "tsx scripts/ai-intake-friction-pass.mjs",
    "assets:play-store": "node scripts/generate-play-store-assets.mjs",
    "assets:ios-app-store": "node scripts/generate-ios-app-store-assets.mjs",
    "assets:invoice-export-samples": "tsx scripts/generate-invoice-export-samples.ts",
    "assets:invoice-export-previews": "python scripts/render-invoice-export-previews.py",
    "check:mobile-wrapper": "node scripts/check-mobile-wrapper-readiness.mjs",
    "check:ios-launch": "node scripts/check-ios-launch-readiness.mjs",
    "bundle:android:release": "npm run cap:sync && node scripts/build-android-release.mjs && npm run check:android-release",
    "check:android-release": "node scripts/check-android-release-status.mjs",
    "react:doctor": "npx react-doctor@latest . --no-lint --no-score --no-telemetry -y",
    "react:doctor:staged": "npx react-doctor@latest . --staged --no-lint --no-score --no-telemetry -y",
    "react:doctor:json": "npx react-doctor@latest . --json --no-lint --no-score --no-telemetry -y > react-doctor-report.json",
    "check:frontend-routes": "npm run build:frontend && tsx scripts/check-frontend-routes.ts",
    "cap:sync": "npm run build:frontend && npx cap sync && node scripts/sync-android-web-assets.mjs",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "public:install-services": "node scripts/public-host.mjs install",
    "public:start": "node scripts/public-host.mjs start",
    "public:stop": "node scripts/public-host.mjs stop",
    "public:tunnel:login": "node scripts/public-host.mjs tunnel-login",
    "public:tunnel:bootstrap": "node scripts/public-host.mjs tunnel-bootstrap",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npx wrangler deploy",
    "cf:check": "npx wrangler deploy --dry-run",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "check:production-sanity": "node scripts/check-production-sanity.mjs",
    "check:google-growth-stack": "node scripts/check-google-growth-stack.mjs",
    "report:google-growth-summary": "node scripts/report-google-growth-summary.mjs",
    "report:google-conversion-readiness": "node scripts/report-google-conversion-readiness.mjs",
    "browser:control": "node scripts/browser-control.mjs",
    "google-ads:clean-conversions": "node scripts/clean-google-ads-conversions.mjs",
    "google-ads:align-conversion-goals": "node scripts/align-google-ads-conversion-goals.mjs",
    "google-ads:create-search-campaign": "node scripts/create-google-search-campaign.mjs",
    "google-ads:tune-search-campaign": "node scripts/tune-google-search-campaign.mjs",
    "report:google-ads-campaign-status": "node scripts/report-google-ads-campaign-status.mjs",
    "report:google-ads-search-terms": "node scripts/report-google-ads-search-terms.mjs",
    "google-ads:add-negative-keywords": "node scripts/add-google-ads-negative-keywords.mjs",
    "google-ads:update-final-urls": "node scripts/update-google-ads-final-urls.mjs",
    "send:launch-email-test": "tsx scripts/send-launch-test-email.ts",
    "check:release": "npm run check:launch && npm run check:public-domain",
    "check:public-domain": "node scripts/check-public-domain-readiness.mjs",
    "check:persistence": "tsx scripts/check-persistence-readiness.ts",
    "migrate:invoices:postgres": "node -r dotenv/config scripts/migrate-saved-invoices-to-postgres.mjs",
    "setup:stripe-launch": "node scripts/bootstrap-stripe-launch.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@remix-run/router": "^1.23.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "abort-controller": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.2",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.82.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.30.3",
    "react-router-dom": "^6.30.3",
    "stripe": "^20.4.1",
    "ts-interface-checker": "^0.1.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.27.3",
    "patch-package": "^8.0.1",
    "playwright": "^1.58.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.83.0"
  }
}
