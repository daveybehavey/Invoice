{
  "name": "invoice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "node scripts/build-frontend.mjs",
    "predev": "npm run build:frontend",
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build:frontend",
    "start": "tsx src/server.ts",
    "prebuild": "npm run build:frontend",
    "build": "tsc --noEmit",
    "pretest": "npm run build:frontend",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts src/**/*.test.ts",
    "test:friction": "node scripts/ai-intake-friction-pass.mjs",
    "check:mobile-wrapper": "node scripts/check-mobile-wrapper-readiness.mjs",
    "public:install-services": "bash scripts/install-notebill-user-services.sh",
    "public:start": "bash scripts/start-notebill-public.sh",
    "public:stop": "bash scripts/stop-notebill-public.sh",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "send:launch-email-test": "tsx scripts/send-launch-test-email.ts",
    "check:release": "npm run check:launch && npm run check:public-domain",
    "check:public-domain": "node scripts/check-public-domain-readiness.mjs",
    "check:persistence": "tsx scripts/check-persistence-readiness.ts",
    "migrate:invoices:postgres": "node -r dotenv/config scripts/migrate-saved-invoices-to-postgres.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.82.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.18.0",
    "stripe": "^20.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.27.3",
    "playwright": "^1.58.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
